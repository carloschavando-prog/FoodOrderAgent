# Existing server-side Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_KEY=sb_secret_replace_me

# Event Kitchen (server-side only). The four-digit PIN is exchanged for the
# protected Event Kitchen session; it is never returned to the browser.
EVENT_KITCHEN_BASE_URL=https://eventhost-opal.vercel.app
EVENT_KITCHEN_PIN=replace_with_event_host_pin
# Used as the server-side compatibility source when no direct PIN is configured.
EVENT_PREP_BASE_URL=https://preplist-theta.vercel.app
PARTY_SOURCE_MAX_AGE_MINUTES=60
# Comma-separated Tripleseat event IDs confirmed by an operator as non-definite
# when an upstream integration continues emitting them.
PARTY_EXCLUDED_EVENT_IDS=

# Resend delivery (server-side only; never expose RESEND_API_KEY to the browser)
RESEND_API_KEY=re_replace_me
ORDER_FEEDBACK_FROM=On Par Purchasing <orders@your-verified-domain.example>
ORDER_FEEDBACK_REPLY_TO=purchasing@your-monitored-domain.example
ORDER_FEEDBACK_TEST_RECIPIENT=owner-preview@example.com

# Purchasing signature
ORDER_FEEDBACK_PURCHASING_NAME=Purchasing Contact
ORDER_FEEDBACK_BUSINESS_NAME=On Par Bar & Grill
ORDER_FEEDBACK_CONTACT=purchasing@example.com | 555-0100

# Representative configuration (full name is accepted; first name is used)
ORDER_FEEDBACK_SYSCO_REP_NAME=Sysco Representative
ORDER_FEEDBACK_SYSCO_REP_EMAIL=sysco-rep@example.com
ORDER_FEEDBACK_GFS_REP_NAME=GFS Representative
ORDER_FEEDBACK_GFS_REP_EMAIL=gfs-rep@example.com
ORDER_FEEDBACK_US_FOODS_REP_NAME=US Foods Representative
ORDER_FEEDBACK_US_FOODS_REP_EMAIL=us-foods-rep@example.com
ORDER_FEEDBACK_PFG_REP_NAME=PFG Representative
ORDER_FEEDBACK_PFG_REP_EMAIL=pfg-rep@example.com

# Safety gate: false is the default.  true alone cannot send; an explicit
# send-live action is also required.
ORDER_FEEDBACK_LIVE_ENABLED=false

# PFG CustomerFirst list used by the API audit helper.
PFG_LIST_ID=168ef1b1-5354-4883-8c26-69a180f6a0ef
